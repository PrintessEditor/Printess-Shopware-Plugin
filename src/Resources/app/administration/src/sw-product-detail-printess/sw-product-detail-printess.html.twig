<div class="sw-product-detail-printess">
    <sw-loader v-if="isLoadingConfigStatus" />

    <mt-banner
        v-else-if="!isConfigured"
        class="sw-product-detail-printess__not-configured"
        variant="critical"
    >
        {{ $t('printess-shopware-integration.productDetail.notConfigured') }}

        <router-link :to="{ name: 'sw.extension.config', params: { namespace: 'PrintessShopwareIntegration' } }">
            {{ $t('printess-shopware-integration.productDetail.goToSettings') }}
        </router-link>
    </mt-banner>

    <template v-else>
        <mt-banner
            class="sw-product-detail-printess__cache-hint"
            variant="info"
        >
            {{ $t('printess-shopware-integration.productDetail.cacheDelayHint') }}
        </mt-banner>

        <mt-banner
            v-if="perLanguageEnabled"
            class="sw-product-detail-printess__per-language-hint"
            variant="info"
        >
            {{ $t('printess-shopware-integration.productDetail.perLanguageHint') }}
        </mt-banner>

        <p v-else class="sw-product-detail-printess__shared-settings-hint">
            {{ $t('printess-shopware-integration.productDetail.sharedSettingsHint') }}
        </p>

        <mt-banner
            v-if="productSettingsSaveError"
            class="sw-product-detail-printess__save-error"
            variant="critical"
        >
            {{ productSettingsSaveError }}
        </mt-banner>

        <sw-loader v-if="!isSettingsReady" />

        <template v-else>
        <mt-card
            class="sw-product-detail-printess__settings-card"
            position-identifier="sw-product-detail-printess-settings"
            :title="$t('printess-shopware-integration.productDetail.cardTitle')"
        >
            <div class="sw-product-detail-printess__template-field">
                <label class="sw-product-detail-printess__template-label">
                    {{ $t('printess-shopware-integration.productDetail.templateFieldLabel') }}
                </label>

                <div class="sw-product-detail-printess__template-preview">
                    <template v-if="selectedTemplateName">
                        <img
                            v-if="selectedTemplate && selectedTemplate.thumbnailUrl"
                            :src="selectedTemplate.thumbnailUrl"
                            :alt="selectedTemplateName"
                            class="sw-product-detail-printess__template-thumbnail"
                        >
                        <div
                            v-else
                            class="sw-product-detail-printess__template-thumbnail sw-product-detail-printess__template-thumbnail--placeholder"
                        >
                            <mt-icon name="regular-image" size="24px" />
                        </div>

                        <span class="sw-product-detail-printess__template-name">
                            {{ selectedTemplateName }}
                        </span>
                    </template>

                    <span v-else class="sw-product-detail-printess__template-empty">
                        {{ $t('printess-shopware-integration.productDetail.noTemplateSelected') }}
                    </span>

                    <mt-button
                        class="sw-product-detail-printess__choose-button"
                        variant="secondary"
                        size="small"
                        :disabled="!canEdit"
                        @click="openTemplatePicker('main')"
                    >
                        {{ $t('printess-shopware-integration.productDetail.chooseTemplateButton') }}
                    </mt-button>

                    <mt-button
                        v-if="selectedTemplateName"
                        class="sw-product-detail-printess__clear-button"
                        variant="ghost"
                        size="small"
                        :disabled="!canEdit"
                        @click="clearTemplate"
                    >
                        {{ $t('printess-shopware-integration.productDetail.clearTemplateButton') }}
                    </mt-button>
                </div>
            </div>

            <div class="sw-product-detail-printess__merge-templates">
                <label class="sw-product-detail-printess__merge-templates-label">
                    {{ $t('printess-shopware-integration.productDetail.mergeTemplatesCardTitle') }}
                </label>

                <p class="sw-product-detail-printess__merge-templates-hint">
                    {{ $t('printess-shopware-integration.productDetail.mergeTemplatesHint') }}
                </p>

                <div
                    v-for="mergeTemplate in mergeTemplates"
                    :key="mergeTemplate.clientId"
                    class="sw-product-detail-printess__merge-template-row"
                >
                    <div v-if="!isLayoutSnippetMode(mergeTemplate.mergeMode)" class="sw-product-detail-printess__merge-template-preview">
                        <template v-if="mergeTemplate.templateName">
                            <img
                                v-if="findTemplateByName(mergeTemplate.templateName) && findTemplateByName(mergeTemplate.templateName).thumbnailUrl"
                                :src="findTemplateByName(mergeTemplate.templateName).thumbnailUrl"
                                :alt="mergeTemplate.templateName"
                                class="sw-product-detail-printess__template-thumbnail"
                            >
                            <div
                                v-else
                                class="sw-product-detail-printess__template-thumbnail sw-product-detail-printess__template-thumbnail--placeholder"
                            >
                                <mt-icon name="regular-image" size="24px" />
                            </div>

                            <span class="sw-product-detail-printess__template-name">
                                {{ mergeTemplate.templateName }}
                            </span>
                        </template>

                        <span v-else class="sw-product-detail-printess__template-empty">
                            {{ $t('printess-shopware-integration.productDetail.noTemplateSelected') }}
                        </span>

                        <mt-button
                            class="sw-product-detail-printess__choose-button"
                            variant="secondary"
                            size="small"
                            :disabled="!canEdit"
                            @click="openTemplatePicker(mergeTemplate.clientId)"
                        >
                            {{ $t('printess-shopware-integration.productDetail.chooseTemplateButton') }}
                        </mt-button>
                    </div>

                    <div v-else class="sw-product-detail-printess__merge-template-preview">
                        <template v-if="mergeTemplate.templateName">
                            <img
                                v-if="layoutSnippetThumbnail(mergeTemplate)"
                                :src="layoutSnippetThumbnail(mergeTemplate)"
                                :alt="layoutSnippetLabel(mergeTemplate)"
                                class="sw-product-detail-printess__template-thumbnail"
                            >
                            <div
                                v-else
                                class="sw-product-detail-printess__template-thumbnail sw-product-detail-printess__template-thumbnail--placeholder"
                            >
                                <mt-icon name="regular-image" size="24px" />
                            </div>

                            <span class="sw-product-detail-printess__template-name">
                                {{ layoutSnippetLabel(mergeTemplate) }}
                            </span>
                        </template>

                        <span v-else class="sw-product-detail-printess__template-empty">
                            {{ $t('printess-shopware-integration.productDetail.noLayoutSnippetSelected') }}
                        </span>

                        <mt-button
                            class="sw-product-detail-printess__choose-button"
                            variant="secondary"
                            size="small"
                            :disabled="!canEdit"
                            @click="openLayoutSnippetPicker(mergeTemplate.clientId)"
                        >
                            {{ $t('printess-shopware-integration.productDetail.chooseLayoutSnippetButton') }}
                        </mt-button>
                    </div>

                    <div class="sw-product-detail-printess__merge-template-settings">
                        <mt-select
                            :model-value="mergeTemplate.mergeMode"
                            class="sw-product-detail-printess__merge-template-mode"
                            :label="$t('printess-shopware-integration.productDetail.mergeModeLabel')"
                            :options="mergeModeOptions"
                            :disabled="!canEdit"
                            @update:model-value="(value) => updateMergeTemplateField(mergeTemplate.clientId, 'mergeMode', value)"
                        />

                        <mt-text-field
                            :model-value="mergeTemplate.documentName"
                            class="sw-product-detail-printess__merge-template-document-name"
                            :name="`sw-field--printess-merge-template-document-name-${mergeTemplate.clientId}`"
                            :label="$t('printess-shopware-integration.productDetail.documentNameLabel')"
                            :placeholder="$t('printess-shopware-integration.productDetail.documentNamePlaceholder')"
                            :disabled="!canEdit"
                            @update:model-value="(value) => updateMergeTemplateField(mergeTemplate.clientId, 'documentName', value)"
                        />

                        <mt-number-field
                            :model-value="mergeTemplate.spreadIndex"
                            class="sw-product-detail-printess__merge-template-spread-index"
                            :name="`sw-field--printess-merge-template-spread-index-${mergeTemplate.clientId}`"
                            :label="$t('printess-shopware-integration.productDetail.spreadIndexLabel')"
                            :disabled="!canEdit"
                            @update:model-value="(value) => updateMergeTemplateField(mergeTemplate.clientId, 'spreadIndex', value)"
                        />

                        <mt-button
                            class="sw-product-detail-printess__merge-template-remove"
                            variant="ghost"
                            size="small"
                            :disabled="!canEdit"
                            @click="removeMergeTemplateRow(mergeTemplate.clientId)"
                        >
                            <mt-icon name="regular-trash" size="16px" />
                        </mt-button>
                    </div>
                </div>

                <mt-button
                    class="sw-product-detail-printess__merge-template-add"
                    variant="secondary"
                    size="small"
                    :disabled="!canEdit"
                    @click="addMergeTemplateRow"
                >
                    {{ $t('printess-shopware-integration.productDetail.addMergeTemplateButton') }}
                </mt-button>
            </div>
        </mt-card>

        <mt-card
            class="sw-product-detail-printess__production-card"
            position-identifier="sw-product-detail-printess-production"
            :title="$t('printess-shopware-integration.productDetail.productionCardTitle')"
        >
            <div class="sw-product-detail-printess__print-setting-field">
                <label class="sw-product-detail-printess__print-setting-label">
                    {{ $t('printess-shopware-integration.productDetail.printSettingLabel') }}
                </label>

                <printess-print-setting-select
                    :value="printSettingName"
                    :disabled="!canEdit"
                    @update:value="updatePrintSettingName"
                />
            </div>

            <div class="sw-product-detail-printess__dropshipping-field">
                <label class="sw-product-detail-printess__dropshipping-label">
                    {{ $t('printess-shopware-integration.productDetail.dropshippingLabel') }}
                </label>

                <printess-dropshipping-select
                    :value="dropshippingConfig"
                    :disabled="!canEdit"
                    @update:value="updateDropshippingConfig"
                />
            </div>
        </mt-card>

        <mt-card
            class="sw-product-detail-printess__form-fields-card"
            position-identifier="sw-product-detail-printess-form-fields"
            :title="$t('printess-shopware-integration.productDetail.formFieldsCardTitle')"
        >
            <p class="sw-product-detail-printess__form-fields-hint">
                {{ $t('printess-shopware-integration.productDetail.formFieldsHint') }}
            </p>

            <div
                v-for="(field, index) in formFields"
                :key="index"
                class="sw-product-detail-printess__form-field-row"
            >
                <div class="sw-product-detail-printess__form-field-inputs">
                    <mt-text-field
                        :model-value="field.name"
                        class="sw-product-detail-printess__form-field-name"
                        :name="`sw-field--printess-form-field-name-${index}`"
                        :label="$t('printess-shopware-integration.productDetail.formFieldNameLabel')"
                        :disabled="!canEdit"
                        @update:model-value="(value) => updateFormField(index, 'name', value)"
                    />

                    <mt-select
                        :model-value="field.source"
                        class="sw-product-detail-printess__form-field-source"
                        :label="$t('printess-shopware-integration.productDetail.formFieldSourceLabel')"
                        :options="formFieldSourceOptions"
                        :disabled="!canEdit"
                        @update:model-value="(value) => updateFormField(index, 'source', value)"
                    />

                    <mt-select
                        v-if="field.source === 'variable'"
                        :model-value="field.variable"
                        class="sw-product-detail-printess__form-field-variable"
                        :label="$t('printess-shopware-integration.productDetail.formFieldVariableLabel')"
                        :options="formFieldVariableOptions"
                        :disabled="!canEdit"
                        @update:model-value="(value) => updateFormField(index, 'variable', value)"
                    />

                    <mt-text-field
                        :model-value="field.value"
                        class="sw-product-detail-printess__form-field-value"
                        :name="`sw-field--printess-form-field-value-${index}`"
                        :label="field.source === 'variable'
                            ? $t('printess-shopware-integration.productDetail.formFieldValueFallbackLabel')
                            : $t('printess-shopware-integration.productDetail.formFieldValueLabel')"
                        :help-text="field.source === 'variable'
                            ? $t('printess-shopware-integration.productDetail.formFieldValueFallbackHelpText')
                            : null"
                        :disabled="!canEdit"
                        @update:model-value="(value) => updateFormField(index, 'value', value)"
                    />

                    <mt-button
                        class="sw-product-detail-printess__form-field-remove"
                        variant="ghost"
                        size="small"
                        :disabled="!canEdit"
                        @click="removeFormField(index)"
                    >
                        <mt-icon name="regular-trash" size="16px" />
                    </mt-button>
                </div>

                <p
                    v-if="formFieldNameCollision(field.name)"
                    class="sw-product-detail-printess__form-field-error"
                >
                    {{ $t('printess-shopware-integration.productDetail.formFieldNameCollisionError', { name: field.name.trim() }) }}
                </p>
            </div>

            <mt-button
                class="sw-product-detail-printess__form-field-add"
                variant="secondary"
                size="small"
                :disabled="!canEdit"
                @click="addFormField"
            >
                {{ $t('printess-shopware-integration.productDetail.addFormFieldButton') }}
            </mt-button>
        </mt-card>

        <mt-card
            class="sw-product-detail-printess__pricing-card"
            position-identifier="sw-product-detail-printess-pricing"
            :title="$t('printess-shopware-integration.productDetail.pricingCardTitle')"
        >
            <p class="sw-product-detail-printess__pricing-hint">
                {{ $t('printess-shopware-integration.productDetail.pricingHint') }}
            </p>

            <div class="sw-product-detail-printess__pricing-page-settings">
                <mt-number-field
                    :model-value="includedPageCount"
                    class="sw-product-detail-printess__included-page-count"
                    name="sw-field--printess-included-page-count"
                    number-type="int"
                    :label="$t('printess-shopware-integration.productDetail.includedPageCountLabel')"
                    :help-text="$t('printess-shopware-integration.productDetail.includedPageCountHelpText')"
                    :placeholder="$t('printess-shopware-integration.productDetail.includedPageCountPlaceholder')"
                    :disabled="!canEdit"
                    @update:model-value="updateIncludedPageCount"
                />

                <mt-number-field
                    :model-value="pricePerPage"
                    class="sw-product-detail-printess__price-per-page"
                    name="sw-field--printess-price-per-page"
                    number-type="float"
                    :label="$t('printess-shopware-integration.productDetail.pricePerPageLabel')"
                    :help-text="$t('printess-shopware-integration.productDetail.pricePerPageHelpText')"
                    :placeholder="$t('printess-shopware-integration.productDetail.pricePerPagePlaceholder')"
                    :disabled="!canEdit"
                    @update:model-value="updatePricePerPage"
                />
            </div>

            <div class="sw-product-detail-printess__price-rules">
                <label class="sw-product-detail-printess__price-rules-label">
                    {{ $t('printess-shopware-integration.productDetail.priceRulesLabel') }}
                </label>

                <p class="sw-product-detail-printess__price-rules-hint">
                    {{ $t('printess-shopware-integration.productDetail.priceRulesHint') }}
                </p>

                <div
                    v-for="rule in priceRules"
                    :key="rule.clientId"
                    class="sw-product-detail-printess__price-rule-row"
                >
                    <div class="sw-product-detail-printess__price-rule-labels">
                        <label class="sw-product-detail-printess__price-rule-labels-label">
                            {{ $t('printess-shopware-integration.productDetail.priceRuleLabelLabel') }}
                        </label>

                        <p class="sw-product-detail-printess__price-rule-labels-hint">
                            {{ $t('printess-shopware-integration.productDetail.priceRuleLabelHelpText') }}
                        </p>

                        <mt-text-field
                            v-for="language in shopLanguages"
                            :key="language.id"
                            :model-value="rule.labelByLanguageId[language.id]"
                            class="sw-product-detail-printess__price-rule-label-input"
                            :name="`sw-field--printess-price-rule-label-${rule.clientId}-${language.id}`"
                            :label="language.name"
                            :placeholder="$t('printess-shopware-integration.productDetail.priceRuleLabelPlaceholder')"
                            :disabled="!canEdit"
                            @update:model-value="(value) => updatePriceRuleLabel(rule.clientId, language.id, value)"
                        />
                    </div>

                    <div class="sw-product-detail-printess__price-rule-conditions">
                        <label class="sw-product-detail-printess__price-rule-conditions-label">
                            {{ $t('printess-shopware-integration.productDetail.priceRuleConditionsLabel') }}
                        </label>

                        <div
                            v-for="(condition, conditionIndex) in rule.conditions"
                            :key="conditionIndex"
                            class="sw-product-detail-printess__price-rule-condition"
                        >
                            <mt-text-field
                                :model-value="condition.name"
                                class="sw-product-detail-printess__price-rule-condition-name"
                                :name="`sw-field--printess-price-rule-condition-name-${rule.clientId}-${conditionIndex}`"
                                :label="$t('printess-shopware-integration.productDetail.formFieldNameLabel')"
                                :disabled="!canEdit"
                                @update:model-value="(value) => updatePriceRuleCondition(rule.clientId, conditionIndex, 'name', value)"
                            />

                            <mt-select
                                :model-value="condition.compareBy"
                                class="sw-product-detail-printess__price-rule-condition-compare-by"
                                :label="$t('printess-shopware-integration.productDetail.compareByLabel')"
                                :options="compareByOptions"
                                :disabled="!canEdit"
                                @update:model-value="(value) => updatePriceRuleCondition(rule.clientId, conditionIndex, 'compareBy', value)"
                            />

                            <mt-select
                                :model-value="condition.operator"
                                class="sw-product-detail-printess__price-rule-condition-operator"
                                :label="$t('printess-shopware-integration.productDetail.operatorLabel')"
                                :options="operatorOptionsFor(condition.compareBy)"
                                :disabled="!canEdit"
                                @update:model-value="(value) => updatePriceRuleCondition(rule.clientId, conditionIndex, 'operator', value)"
                            />

                            <mt-number-field
                                v-if="condition.compareBy === 'length'"
                                :model-value="condition.value"
                                class="sw-product-detail-printess__price-rule-condition-value"
                                :name="`sw-field--printess-price-rule-condition-value-${rule.clientId}-${conditionIndex}`"
                                number-type="int"
                                :label="$t('printess-shopware-integration.productDetail.formFieldValueLengthLabel')"
                                :disabled="!canEdit"
                                @update:model-value="(value) => updatePriceRuleCondition(rule.clientId, conditionIndex, 'value', value)"
                            />
                            <mt-text-field
                                v-else
                                :model-value="condition.value"
                                class="sw-product-detail-printess__price-rule-condition-value"
                                :name="`sw-field--printess-price-rule-condition-value-${rule.clientId}-${conditionIndex}`"
                                :label="$t('printess-shopware-integration.productDetail.formFieldValueLabel')"
                                :disabled="!canEdit"
                                @update:model-value="(value) => updatePriceRuleCondition(rule.clientId, conditionIndex, 'value', value)"
                            />

                            <mt-button
                                v-if="rule.conditions.length > 1"
                                class="sw-product-detail-printess__price-rule-condition-remove"
                                variant="ghost"
                                size="small"
                                :disabled="!canEdit"
                                @click="removePriceRuleCondition(rule.clientId, conditionIndex)"
                            >
                                <mt-icon name="regular-trash" size="16px" />
                            </mt-button>
                        </div>

                        <mt-button
                            class="sw-product-detail-printess__price-rule-condition-add"
                            variant="secondary"
                            size="x-small"
                            :disabled="!canEdit"
                            @click="addPriceRuleCondition(rule.clientId)"
                        >
                            {{ $t('printess-shopware-integration.productDetail.addPriceRuleConditionButton') }}
                        </mt-button>
                    </div>

                    <div class="sw-product-detail-printess__price-rule-amounts">
                        <mt-number-field
                            :model-value="rule.price"
                            class="sw-product-detail-printess__price-rule-price"
                            :name="`sw-field--printess-price-rule-price-${rule.clientId}`"
                            number-type="float"
                            :label="$t('printess-shopware-integration.productDetail.priceRulePriceLabel')"
                            :placeholder="$t('printess-shopware-integration.productDetail.priceRulePricePlaceholder')"
                            :disabled="!canEdit"
                            @update:model-value="(value) => updatePriceRuleField(rule.clientId, 'price', value)"
                        />

                        <mt-number-field
                            :model-value="rule.pricePerPage"
                            class="sw-product-detail-printess__price-rule-price-per-page"
                            :name="`sw-field--printess-price-rule-price-per-page-${rule.clientId}`"
                            number-type="float"
                            :label="$t('printess-shopware-integration.productDetail.priceRulePricePerPageLabel')"
                            :placeholder="$t('printess-shopware-integration.productDetail.priceRulePricePerPagePlaceholder')"
                            :disabled="!canEdit"
                            @update:model-value="(value) => updatePriceRuleField(rule.clientId, 'pricePerPage', value)"
                        />

                        <mt-button
                            class="sw-product-detail-printess__price-rule-remove"
                            variant="ghost"
                            size="small"
                            :disabled="!canEdit"
                            @click="removePriceRule(rule.clientId)"
                        >
                            <mt-icon name="regular-trash" size="16px" />
                        </mt-button>
                    </div>
                </div>

                <mt-button
                    class="sw-product-detail-printess__price-rule-add"
                    variant="secondary"
                    size="small"
                    :disabled="!canEdit"
                    @click="addPriceRule"
                >
                    {{ $t('printess-shopware-integration.productDetail.addPriceRuleButton') }}
                </mt-button>
            </div>
        </mt-card>

        <mt-card
            class="sw-product-detail-printess__inside-page-count-card"
            position-identifier="sw-product-detail-printess-inside-page-count"
        >
            <template #title>
                <div class="sw-product-detail-printess__card-title-with-toggle">
                    <mt-switch
                        :model-value="insidePageCountEnabled"
                        class="sw-product-detail-printess__inside-page-count-enabled-toggle"
                        :aria-label="$t('printess-shopware-integration.productDetail.insidePageCountEnabledLabel')"
                        :disabled="!canEdit"
                        @update:model-value="updateInsidePageCountEnabled"
                    />
                    <mt-text as="h3" weight="semibold" size="m" class="mt-card__title">
                        {{ $t('printess-shopware-integration.productDetail.insidePageCountCardTitle') }}
                    </mt-text>
                </div>
            </template>

            <mt-banner
                v-if="showInsidePageCountConflictError"
                class="sw-product-detail-printess__inside-page-count-conflict-error"
                variant="critical"
            >
                {{ $t('printess-shopware-integration.productDetail.insidePageCountConflictError') }}
            </mt-banner>

            <p class="sw-product-detail-printess__inside-page-count-hint">
                {{ $t('printess-shopware-integration.productDetail.insidePageCountHint') }}
            </p>

            <mt-number-field
                :model-value="insidePageCount"
                class="sw-product-detail-printess__inside-page-count"
                name="sw-field--printess-inside-page-count"
                number-type="int"
                :min="4"
                :allow-empty="true"
                :label="$t('printess-shopware-integration.productDetail.insidePageCountLabel')"
                :help-text="$t('printess-shopware-integration.productDetail.insidePageCountHelpText')"
                :disabled="!canEdit || !insidePageCountEnabled"
                @update:model-value="updateInsidePageCount"
            />
        </mt-card>

        <mt-card
            class="sw-product-detail-printess__book-settings-card"
            position-identifier="sw-product-detail-printess-book-settings"
        >
            <template #title>
                <div class="sw-product-detail-printess__card-title-with-toggle">
                    <mt-switch
                        :model-value="magicPhotobookEnabled"
                        class="sw-product-detail-printess__book-settings-enabled-toggle"
                        :aria-label="$t('printess-shopware-integration.productDetail.magicPhotobookEnabledLabel')"
                        :disabled="!canEdit"
                        @update:model-value="updateMagicPhotobookEnabled"
                    />

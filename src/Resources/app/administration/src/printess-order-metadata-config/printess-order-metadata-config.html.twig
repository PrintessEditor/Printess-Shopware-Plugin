{% block printess_order_metadata_config %}
<div class="printess-order-metadata-config">
    {% block printess_order_metadata_config_help %}
    <div class="printess-order-metadata-config__help">
        <button
            type="button"
            class="printess-order-metadata-config__help-toggle"
            :aria-expanded="showHelp ? 'true' : 'false'"
            @click="showHelp = !showHelp"
        >
            <mt-icon :name="showHelp ? 'regular-chevron-down-xs' : 'regular-chevron-right-xs'" size="12px" />
            {{ $t('printess-shopware-integration.orderMetaDataConfig.help.toggle') }}
        </button>

        <div v-if="showHelp" class="printess-order-metadata-config__help-body">
            <p>{{ $t('printess-shopware-integration.orderMetaDataConfig.help.intro') }}</p>
            <p>{{ $t('printess-shopware-integration.orderMetaDataConfig.help.usage', helpParams) }}</p>
            <ul>
                <li>{{ $t('printess-shopware-integration.orderMetaDataConfig.help.keys') }}</li>
                <li>{{ $t('printess-shopware-integration.orderMetaDataConfig.help.knownKeys', { keys: knownKeys.join(', ') }) }}</li>
                <li>{{ $t('printess-shopware-integration.orderMetaDataConfig.help.empty') }}</li>
                <li v-if="showPluginDefaults">{{ $t('printess-shopware-integration.orderMetaDataConfig.help.productOverride') }}</li>
                <li v-else>{{ $t('printess-shopware-integration.orderMetaDataConfig.help.pluginLevel') }}</li>
            </ul>
        </div>
    </div>
    {% endblock %}

    {% block printess_order_metadata_config_plugin_rows %}
    <div
        v-if="showPluginDefaults && pluginRows.length"
        class="printess-order-metadata-config__plugin-rows"
    >
        <p class="printess-order-metadata-config__plugin-rows-title">
            {{ $t('printess-shopware-integration.orderMetaDataConfig.pluginRowsTitle') }}
        </p>

        <ul>
            <li
                v-for="pluginRow in pluginRows"
                :key="pluginRow.key"
                class="printess-order-metadata-config__plugin-row"
                :class="{ 'printess-order-metadata-config__plugin-row--overridden': isOverridden(pluginRow) }"
            >
                <code>{{ pluginRow.key }}</code>
                <span class="printess-order-metadata-config__plugin-row-value">{{ pluginRow.value }}</span>
                <span v-if="isOverridden(pluginRow)" class="printess-order-metadata-config__plugin-row-note">
                    {{ $t('printess-shopware-integration.orderMetaDataConfig.overridden') }}
                </span>
            </li>
        </ul>
    </div>
    {% endblock %}

    {% block printess_order_metadata_config_rows %}
    <datalist :id="keyListId">
        <option v-for="key in knownKeys" :key="key" :value="key" />
    </datalist>

    <div
        v-for="row in rows"
        :key="row.id"
        class="printess-order-metadata-config__row"
    >
        <div class="printess-order-metadata-config__row-inputs">
            <div class="printess-order-metadata-config__key">
                <label class="printess-order-metadata-config__label" :for="`${keyListId}-${row.id}`">
                    {{ $t('printess-shopware-integration.orderMetaDataConfig.keyLabel') }}
                </label>
                <input
                    :id="`${keyListId}-${row.id}`"
                    class="printess-order-metadata-config__key-input"
                    type="text"
                    autocomplete="off"
                    :list="keyListId"
                    :value="row.key"
                    :placeholder="$t('printess-shopware-integration.orderMetaDataConfig.keyPlaceholder')"
                    :disabled="disabled"
                    @input="updateRow(row.id, 'key', $event.target.value)"
                >
            </div>

            <div class="printess-order-metadata-config__value">
                <printess-placeholder-input
                    :value="row.value"
                    :name="`printess-order-metadata-value-${row.id}`"
                    :label="$t('printess-shopware-integration.orderMetaDataConfig.valueLabel')"
                    :placeholder="valuePlaceholder"
                    :disabled="disabled"
                    :group-names="groupNames"
                    :preview-product="previewProduct"
                    @update:value="(value) => updateRow(row.id, 'value', value)"
                />
            </div>

            <mt-button
                class="printess-order-metadata-config__remove"
                variant="ghost"
                size="small"
                :disabled="disabled"
                :aria-label="$t('printess-shopware-integration.orderMetaDataConfig.removeEntry')"
                @click="removeRow(row.id)"
            >
                <mt-icon name="regular-trash" size="16px" />
            </mt-button>
        </div>

        <p v-if="keyError(row)" class="printess-order-metadata-config__error">
            {{ keyError(row) }}
        </p>
    </div>

    <p v-if="!rows.length" class="printess-order-metadata-config__empty">
        {{ $t('printess-shopware-integration.orderMetaDataConfig.empty') }}
    </p>

    <mt-button
        class="printess-order-metadata-config__add"
        variant="secondary"
        size="small"
        :disabled="disabled"
        @click="addRow"
    >
        {{ $t('printess-shopware-integration.orderMetaDataConfig.addEntry') }}
    </mt-button>
    {% endblock %}
</div>
{% endblock %}

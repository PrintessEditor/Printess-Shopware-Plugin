<sw-modal
    class="printess-variant-sync"
    variant="large"
    :title="$t('printess-shopware-integration.productDetail.variantSync.title')"
    @modal-close="close"
>
    <p class="printess-variant-sync__intro">
        {{ $t('printess-shopware-integration.productDetail.variantSync.intro') }}
    </p>

    <mt-banner
        v-if="error"
        class="printess-variant-sync__banner"
        variant="critical"
    >
        {{ error }}
    </mt-banner>

    <mt-banner
        v-if="hasUnsavedChanges"
        class="printess-variant-sync__banner"
        variant="attention"
    >
        {{ $t('printess-shopware-integration.productDetail.variantSync.unsavedChanges') }}
    </mt-banner>

    <sw-loader v-if="isLoading && !plan" />

    <template v-if="plan">
        {# ---------------------------------------------------------------- choices #}
        <h3 class="printess-variant-sync__heading">
            {{ $t('printess-shopware-integration.productDetail.variantSync.choicesHeading') }}
        </h3>

        <p
            v-if="plan.choices.length === 0"
            class="printess-variant-sync__line printess-variant-sync__line--warning"
        >
            {{ $t('printess-shopware-integration.productDetail.variantSync.noChoices') }}
        </p>

        <div
            v-for="choice in plan.choices"
            :key="choice.name"
            class="printess-variant-sync__choice"
            :class="{ 'is--unavailable': isChoiceUnavailable(choice) }"
        >
            <mt-checkbox
                :checked="isSelected(choice)"
                :label="choiceTitle(choice)"
                :disabled="isChoiceUnavailable(choice) || isApplying"
                @update:checked="(checked) => toggleChoice(choice, checked)"
            />

            <span class="printess-variant-sync__meta">{{ choiceValues(choice) }}</span>
            <span
                v-if="choiceMatch(choice)"
                class="printess-variant-sync__meta"
            >
                {{ choiceMatch(choice) }}
            </span>
            <span
                v-if="!choice.isPriceRelevant"
                class="printess-variant-sync__meta printess-variant-sync__line--warning"
            >
                {{ $t('printess-shopware-integration.productDetail.variantSync.notPriceRelevant') }}
            </span>
        </div>

        {# ---------------------------------------------------------------- preview #}
        <h3 class="printess-variant-sync__heading">
            {{ $t('printess-shopware-integration.productDetail.variantSync.previewHeading') }}
            <sw-loader
                v-if="isLoading"
                size="16px"
                class="printess-variant-sync__inline-loader"
            />
        </h3>

        <p
            v-if="plan.becomesVariantProduct"
            class="printess-variant-sync__line printess-variant-sync__line--warning"
        >
            {{ $t('printess-shopware-integration.productDetail.variantSync.becomesVariantProduct') }}
        </p>

        <template
            v-for="group in plan.groups"
            :key="group.name"
        >
            <p
                v-if="isGroupUnchanged(group)"
                class="printess-variant-sync__line printess-variant-sync__line--success"
            >
                {{ $t('printess-shopware-integration.productDetail.variantSync.groupUnchanged', { group: group.name }) }}
            </p>

            <div
                v-else
                class="printess-variant-sync__block"
            >
                <p class="printess-variant-sync__block-title">
                    {{ groupTitle(group) }}
                </p>

                <p
                    v-if="group.added.length"
                    class="printess-variant-sync__line printess-variant-sync__line--success"
                >
                    {{ $t('printess-shopware-integration.productDetail.variantSync.optionsAdded', { values: quoted(group.added) }) }}
                </p>

                <p
                    v-if="group.created.length"
                    class="printess-variant-sync__line printess-variant-sync__line--success"
                >
                    {{ $t('printess-shopware-integration.productDetail.variantSync.optionsCreated', { values: quoted(group.created) }) }}
                </p>

                <template v-if="group.removed.length || group.kept.length">
                    <p class="printess-variant-sync__hint">
                        {{ $t('printess-shopware-integration.productDetail.variantSync.hintOptions') }}
                    </p>

                    <mt-checkbox
                        v-for="option in [...group.removed, ...group.kept]"
                        :key="option.id"
                        :checked="!keep.options.includes(option.id)"
                        :label="$t('printess-shopware-integration.productDetail.variantSync.removeOption', { value: option.name })"
                        :disabled="isApplying"
                        @update:checked="(remove) => setRemoval('options', option.id, remove)"
                    />
                </template>
            </div>
        </template>

        <div
            v-if="plan.removedGroups.length || plan.keptGroups.length"
            class="printess-variant-sync__block"
        >
            <p class="printess-variant-sync__block-title">
                {{ $t('printess-shopware-integration.productDetail.variantSync.otherGroups') }}
            </p>

            <p class="printess-variant-sync__hint">
                {{ $t('printess-shopware-integration.productDetail.variantSync.hintGroups') }}
            </p>

            <mt-checkbox
                v-for="group in plan.removedGroups"
                :key="group.id"
                :checked="true"
                :label="$t('printess-shopware-integration.productDetail.variantSync.removeGroup', { group: group.name, values: group.values.join(', ') })"
                :disabled="isApplying"
                @update:checked="(remove) => setRemoval('groups', group.id, remove)"
            />

            <mt-checkbox
                v-for="group in plan.keptGroups"
                :key="group.id"
                :checked="false"
                :label="$t('printess-shopware-integration.productDetail.variantSync.removeGroupShort', { group: group.name })"
                :disabled="isApplying"
                @update:checked="(remove) => setRemoval('groups', group.id, remove)"
            />
        </div>

        {# ---------------------------------------------------------------- variants #}
        <div class="printess-variant-sync__block">
            <p class="printess-variant-sync__block-title">
                {{ $t('printess-shopware-integration.productDetail.variantSync.variantsTitle', { count: variants.existing }) }}
            </p>

            <details
                v-if="variants.create.length"
                class="printess-variant-sync__details"
            >
                <summary>
                    {{ $t('printess-shopware-integration.productDetail.variantSync.create', { count: variants.create.length }) }}
                </summary>
                <ul>
                    <li
                        v-for="(item, index) in variants.create"
                        :key="index"
                    >
                        {{ item.copyFrom
                            ? $t('printess-shopware-integration.productDetail.variantSync.createFrom', { variant: item.label, source: item.copyFrom })
                            : item.label }}
                    </li>
                </ul>
            </details>

            <p
                v-if="variants.missing > variants.create.length"
                class="printess-variant-sync__line printess-variant-sync__line--warning"
            >
                {{ $t('printess-shopware-integration.productDetail.variantSync.limit', { created: variants.create.length, missing: variants.missing }) }}
            </p>

            <p
                v-if="variants.update"
                class="printess-variant-sync__hint"
            >
                {{ $t('printess-shopware-integration.productDetail.variantSync.update', { count: variants.update }) }}
            </p>

            <template v-if="variants.delete.length || variants.kept.length">
                <p class="printess-variant-sync__hint">
                    {{ $t('printess-shopware-integration.productDetail.variantSync.hintVariants') }}
                </p>

                <mt-checkbox
                    v-for="item in variants.delete"
                    :key="item.id"
                    :checked="true"
                    :label="$t('printess-shopware-integration.productDetail.variantSync.deleteVariant', { variant: item.label })"
                    :disabled="isApplying"
                    @update:checked="(remove) => setRemoval('variants', item.id, remove)"
                />

                <mt-checkbox
                    v-for="item in variants.kept"
                    :key="item.id"
                    :checked="false"
                    :label="$t('printess-shopware-integration.productDetail.variantSync.deleteVariant', { variant: item.label })"
                    :disabled="isApplying"
                    @update:checked="(remove) => setRemoval('variants', item.id, remove)"
                />
            </template>

            <details
                v-if="variants.merged.length"
                class="printess-variant-sync__details"
            >
                <summary>
                    {{ $t('printess-shopware-integration.productDetail.variantSync.merged', { count: variants.merged.length }) }}
                </summary>
                <ul>
                    <li
                        v-for="item in variants.merged"
                        :key="item.id"
                    >
                        {{ $t('printess-shopware-integration.productDetail.variantSync.mergedInto', { variant: item.label, survivor: item.mergedInto }) }}
                    </li>
                </ul>
                <p class="printess-variant-sync__hint">
                    {{ $t('printess-shopware-integration.productDetail.variantSync.mergedHelp') }}
                </p>
            </details>

            <p
                v-if="variantsUnchanged"
                class="printess-variant-sync__line printess-variant-sync__line--success"
            >
                {{ $t('printess-shopware-integration.productDetail.variantSync.variantsUnchanged') }}
            </p>
        </div>

        <p
            v-for="(note, index) in plan.notes"
            :key="`note-${index}`"
            class="printess-variant-sync__line printess-variant-sync__line--warning"
        >
            {{ noteText(note) }}
        </p>
    </template>

    <template #modal-footer>
        <p class="printess-variant-sync__footer-warning">
            {{ $t('printess-shopware-integration.productDetail.variantSync.applyWarning') }}
        </p>

        <mt-button
            variant="secondary"
            :disabled="isApplying"
            @click="close"
        >
            {{ $t('printess-shopware-integration.productDetail.variantSync.cancel') }}
        </mt-button>

        <mt-button
            variant="primary"
            :disabled="!canApply"
            :is-loading="isApplying"
            @click="apply"
        >
            {{ $t('printess-shopware-integration.productDetail.variantSync.apply') }}
        </mt-button>
    </template>
</sw-modal>

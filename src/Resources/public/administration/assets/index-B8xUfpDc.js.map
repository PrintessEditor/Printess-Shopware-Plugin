{% block printess_dropshipping_select %}
<div class="printess-dropshipping-select">
    <mt-select
        label=""
        class="printess-dropshipping-select__mode"
        :model-value="mode"
        :options="modeOptions"
        :disabled="disabled"
        @update:model-value="onModeChange"
    />

    <mt-banner
        v-if="mode === 'dropshipping' && loadError"
        variant="critical"
        class="printess-dropshipping-select__error"
    >
        {{ loadError }}
    </mt-banner>

    <div
        v-else-if="mode === 'dropshipping'"
        class="printess-dropshipping-select__product-definition-combobox"
    >
        <div
            ref="productDefinitionField"
            class="mt-field mt-field--text printess-dropshipping-select__product-definition"
            :class="{ 'has--focus': isProductDefinitionDropdownOpen, 'is--disabled': disabled || isLoading }"
        >
            <div class="mt-block-field__block">
                <input
                    type="text"
                    class="printess-dropshipping-select__product-definition-input"
                    autocomplete="off"
                    :disabled="disabled || isLoading"
                    :placeholder="isLoading
                        ? $t('printess-shopware-integration.dropshippingSelect.loadingProductDefinitions')
                        : $t('printess-shopware-integration.dropshippingSelect.selectProductDefinitionPlaceholder')"
                    :value="productDefinitionInputValue"
                    role="combobox"
                    aria-haspopup="listbox"
                    :aria-expanded="isProductDefinitionDropdownOpen"
                    @focus="openProductDefinitionDropdown"
                    @input="onProductDefinitionSearchInput"
                    @keydown="onProductDefinitionSearchKeydown"
                >

                <div class="mt-field__addition">
                    <mt-icon name="regular-chevron-down-xs" size="12px" color="var(--color-icon-primary-default)" />
                </div>
            </div>

            {# Rendered into <body>, like mt-select's own option list: the surrounding mt-card
               clips its content (`overflow: hidden`), which cut off a popover positioned inside
               it. See `updateProductDefinitionPopoverPosition`. #}
            <teleport to="body">
                <div
                    v-if="isProductDefinitionDropdownOpen"
                    ref="productDefinitionPopover"
                    class="printess-dropshipping-select__product-definition-popover"
                    :style="productDefinitionPopoverStyle"
                    role="listbox"
                >
                    <template v-if="filteredGroupedProductDefinitions.length > 0">
                        <ul
                            v-for="group in filteredGroupedProductDefinitions"
                            :key="group.name"
                            class="printess-dropshipping-select__product-definition-group"
                        >
                            <li class="printess-dropshipping-select__product-definition-group-label">
                                {{ group.name }}
                            </li>

                            <li
                                v-for="definition in group.definitions"
                                :key="definition.id"
                                class="printess-dropshipping-select__product-definition-option"
                                :class="{
                                    'is--active': definition.id === highlightedDefinitionId,
                                    'is--selected': definition.id === productDefinitionId,
                                }"
                                role="option"
                                :aria-selected="definition.id === productDefinitionId"
                                @mouseenter="highlightedDefinitionId = definition.id"
                                @mousedown.prevent="selectProductDefinition(definition)"
                            >
                                {{ definition.label }}
                            </li>
                        </ul>
                    </template>

                    <p v-else class="printess-dropshipping-select__product-definition-empty">
                        {{ $t('printess-shopware-integration.dropshippingSelect.noProductDefinitionsFound') }}
                    </p>
                </div>
            </teleport>
        </div>
    </div>

    <mt-banner
        v-if="mode === 'template'"
        variant="attention"
        class="printess-dropshipping-select__template-hint"
    >
        {{ $t('printess-shopware-integration.dropshippingSelect.templateSettingsHint') }}
    </mt-banner>

    <p
        v-else-if="mode === 'pluginDefault'"
        class="printess-dropshipping-select__hint"
    >
        {{ $t('printess-shopware-integration.dropshippingSelect.pluginDefaultHint') }}
    </p>
</div>
{% endblock %}

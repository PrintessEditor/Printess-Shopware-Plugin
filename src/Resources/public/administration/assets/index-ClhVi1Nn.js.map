{% block printess_production_batch_list %}
<div class="printess-production-batch-list">
    <ul class="printess-production-batch-list__items">
        <li
            v-for="item in items"
            :key="item.id"
            class="printess-production-batch-list__item"
        >
            <input
                v-if="selectable"
                type="checkbox"
                class="printess-production-batch-list__checkbox"
                :checked="selectedIds.includes(item.id)"
                @change="toggleSelected(item.id, $event.target.checked)"
            >
            <button
                v-if="item.thumbnailUrl"
                type="button"
                class="printess-production-batch-list__thumbnail-button"
                :title="$t('printess-shopware-integration.orderLineItemProduction.thumbnailOverlayTitle')"
                @click="openThumbnail(item)"
            >
                <img
                    :src="item.thumbnailUrl"
                    :alt="$t('printess-shopware-integration.orderLineItemProduction.thumbnailAlt')"
                    class="printess-production-batch-list__thumbnail"
                >
            </button>
            <span v-else class="printess-production-batch-list__thumbnail printess-production-batch-list__thumbnail--empty"></span>

            <span class="printess-production-batch-list__label">{{ item.label }}</span>
            <span class="printess-production-batch-list__quantity">
                {{ $t('printess-shopware-integration.productionBatch.quantity', { quantity: item.quantity }) }}
            </span>

            <mt-button
                v-if="editable"
                class="printess-production-batch-list__edit-button"
                variant="secondary"
                size="small"
                @click="$emit('edit', item.id)"
            >
                {{ $t('printess-shopware-integration.productionBatch.editButton') }}
            </mt-button>
        </li>
    </ul>

    {# A modal of its own on top of the dialog the list is shown in - sw-modal attaches itself to
       the end of the body, so it stacks above, and Escape / an outside click only close this one. #}
    <sw-modal
        v-if="fullSizeThumbnailUrl"
        class="printess-production-batch-list__thumbnail-modal"
        :title="$t('printess-shopware-integration.orderLineItemProduction.thumbnailOverlayTitle')"
        @modal-close="closeThumbnail"
    >
        <img
            :src="fullSizeThumbnailUrl"
            :alt="$t('printess-shopware-integration.orderLineItemProduction.thumbnailAlt')"
            class="printess-production-batch-list__thumbnail-large"
        >

        <template #modal-footer>
            <mt-button variant="secondary" @click="closeThumbnail">
                {{ $t('printess-shopware-integration.orderLineItemProduction.closeButton') }}
            </mt-button>
        </template>
    </sw-modal>
</div>
{% endblock %}

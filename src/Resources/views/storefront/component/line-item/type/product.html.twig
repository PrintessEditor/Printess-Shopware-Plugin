{% sw_extends '@Storefront/storefront/component/line-item/type/product.html.twig' %}

{% block component_line_item_type_product_details_container %}
    {{ parent() }}

    {% set printessSaveToken = lineItem.payload is defined and lineItem.payload._printessSaveToken is defined ? lineItem.payload._printessSaveToken : null %}

    {% if printessSaveToken %}
        <div class="printess-cart-item-edit-button-container">
            {% if displayMode === 'order' %}
                {# An already-placed order must never be edited in place - this leads to the
                   "reorder" flow instead, which only ever adds a new item to the current cart. #}
                <a
                    href="{{ path('frontend.printess.order.reorder.edit', { orderId: order.id, lineItemId: lineItem.id }) }}"
                    class="btn btn-outline-secondary btn-sm printess-cart-item-edit-button"
                >
                    {{ 'printess.cartItem.reorderButton'|trans|sw_sanitize }}
                </a>
            {% else %}
                <a
                    href="{{ path('frontend.printess.cart.edit', { lineItemId: lineItem.id }) }}"
                    class="btn btn-outline-secondary btn-sm printess-cart-item-edit-button"
                >
                    {{ 'printess.cartItem.editButton'|trans|sw_sanitize }}
                </a>
            {% endif %}
        </div>
    {% endif %}

    {% set printessPriceBreakdown = lineItem.payload is defined and lineItem.payload._printessPriceBreakdown is defined ? lineItem.payload._printessPriceBreakdown : null %}
    {% set printessPageSurcharge = printessPriceBreakdown is not null and printessPriceBreakdown.pageSurcharge is defined ? printessPriceBreakdown.pageSurcharge : 0 %}
    {% set printessRuleSurcharges = printessPriceBreakdown is not null and printessPriceBreakdown.ruleSurcharges is defined ? printessPriceBreakdown.ruleSurcharges : [] %}

    {% if printessPageSurcharge != 0 or printessRuleSurcharges|length > 0 %}
        <ul class="printess-cart-item-price-breakdown">
            {% if printessPageSurcharge != 0 %}
                <li class="printess-cart-item-price-breakdown-entry">
                    <span class="printess-cart-item-price-breakdown-label">
                        {{ 'printess.cartItem.priceBreakdown.additionalPages'|trans({ '%count%': printessPriceBreakdown.billablePageCount })|sw_sanitize }}
                    </span>
                    <span class="printess-cart-item-price-breakdown-price">
                        {% if displayMode === 'order' %}
                            +{{ printessPageSurcharge|currency(order.currency.isoCode) }}
                        {% else %}
                            +{{ printessPageSurcharge|currency }}
                        {% endif %}
                    </span>
                </li>
            {% endif %}

            {% for printessRuleSurcharge in printessRuleSurcharges %}
                <li class="printess-cart-item-price-breakdown-entry">
                    <span class="printess-cart-item-price-breakdown-label">
                        {{ printessRuleSurcharge.label }}
                    </span>
                    <span class="printess-cart-item-price-breakdown-price">
                        {% if displayMode === 'order' %}
                            +{{ printessRuleSurcharge.price|currency(order.currency.isoCode) }}
                        {% else %}
                            +{{ printessRuleSurcharge.price|currency }}
                        {% endif %}
                    </span>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}

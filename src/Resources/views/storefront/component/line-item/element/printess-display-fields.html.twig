{# Form field values the product shows in the cart ("Number Of Tiles: 10"), rebuilt by
   `PrintessCartDisplayCollector` on every cart calculation and carried into the order. Uses core's
   variant characteristics markup so the rows read like the variant options line above them. #}
{% block printess_line_item_display_fields %}
    {% set printessCartDisplay = lineItem.payload._printessCartDisplay is defined ? lineItem.payload._printessCartDisplay : [] %}

    {% if printessCartDisplay is iterable and printessCartDisplay|length > 0 %}
        <div class="line-item-details-characteristics printess-cart-item-display-fields">
            {% for printessDisplayRow in printessCartDisplay %}
                {% set printessDisplayValue = printessDisplayRow.value %}
                {% if printessDisplayValue|lower == 'true' %}
                    {% set printessDisplayValue = 'printess.cartItem.displayField.yes'|trans|striptags %}
                {% elseif printessDisplayValue|lower == 'false' %}
                    {% set printessDisplayValue = 'printess.cartItem.displayField.no'|trans|striptags %}
                {% endif %}

                {{ printessDisplayRow.label }}:
                <span class="line-item-details-characteristics-option">{{ printessDisplayValue }}</span>

                {% if not loop.last %}
                    {{ ' | ' }}
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
